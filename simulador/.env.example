# Copia este archivo como simulador/.env. .env NUNCA se sube a Git.
# Si no existe, el simulador toma DEVICE_API_KEY de backend/.env.

# URL base de la API (incluye /api). En Render: https://<servicio>.onrender.com/api
API_URL=http://localhost:8080/api

# La misma clave que DEVICE_API_KEY de la API.
DEVICE_API_KEY=cambia-esta-clave

DISPOSITIVO_ID=maceta-01
