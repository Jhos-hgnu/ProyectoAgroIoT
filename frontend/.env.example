# Copia este archivo como frontend/.env. .env NUNCA se sube a Git.

# URL base de la API (incluye /api). En Render: https://<servicio>.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Firebase (cliente web, solo lectura). Se usará más adelante.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
