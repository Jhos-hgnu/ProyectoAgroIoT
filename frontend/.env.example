# Copia este archivo como frontend/.env. .env NUNCA se sube a Git.

# URL base de la API (incluye /api). En Render: https://<servicio>.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Opcional, solo con `npm run dev`: usar la API de Render sin backend local ni CORS.
# Cambia VITE_API_URL por /api y descomenta (Vite reenvía /api a esta URL):
#API_PROXY_TARGET=https://<servicio>.onrender.com

# Firebase (cliente web, solo lectura). Se usará más adelante.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
