# Copia este archivo como backend/.env y ajusta los valores. .env NUNCA se sube a Git.

# Local con docker compose (si usas DB_PORT=5433, cambia el puerto aquí).
# Neon: jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/agroiot
DB_USER=agroiot
DB_PASSWORD=agroiot

# Clave que el ESP32 envía en X-Api-Key. Genera una propia (p. ej. openssl rand -hex 24).
DEVICE_API_KEY=cambia-esta-clave

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

PORT=8080

# Más adelante:
# GEMINI_API_KEY=
# FIREBASE_CREDENTIALS=
# FIREBASE_DB_URL=
