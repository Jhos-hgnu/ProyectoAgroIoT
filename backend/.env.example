# Copia este archivo como backend/.env y ajusta los valores. .env NUNCA se sube a Git.

# Local con docker compose (si usas DB_PORT=5433, cambia el puerto aquí).
# Neon: jdbc:postgresql://<host>.neon.tech/<base>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/agroiot
DB_USER=agroiot
DB_PASSWORD=agroiot

# Clave que el ESP32 envía en X-Api-Key. Genera una propia (p. ej. openssl rand -hex 24).
DEVICE_API_KEY=cambia-esta-clave

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

PORT=8080

# Firebase Realtime Database (estado en vivo). Vacía = la API funciona sin Firebase (NO_CONFIGURADO).
# Emulador local (ver firebase/README.md): no necesita FIREBASE_CREDENTIALS.
# FIREBASE_DB_URL=http://127.0.0.1:9000?ns=demo-agroiot-default-rtdb
# Firebase real: la URL de la consola y la llave de service account (el JSON completo o la ruta al archivo).
# FIREBASE_DB_URL=https://<proyecto>-default-rtdb.firebaseio.com
# FIREBASE_CREDENTIALS=C:/ruta/fuera/del/repo/agroiot-firebase-adminsdk.json

# Reportes de IA: key de Google AI Studio (https://aistudio.google.com/apikey).
# Vacía = la API funciona igual y POST /reportes responde 502 IA_NO_DISPONIBLE.
GEMINI_API_KEY=
# Modelo de Gemini (opcional).
# GEMINI_MODEL=gemini-3.8-flash
